# ---- Server ----
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/nyaya_ai

# ---- Auth ---- (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=<TEMPORARY_SECRET_AT_LEAST_16_CHARS>
JWT_EXPIRES_IN=7d

# ---- Services ----
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ---- Optional Gemini (leave empty to use rule/template fallback) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Limits ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30
SIMILARITY_CANDIDATE_LIMIT=1000

# ---- Seed script ----
SEED_ADMIN_EMAIL=admin@nyaya.local
SEED_ADMIN_PASSWORD=Admin@12345
