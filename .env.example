# Root env file used by docker-compose. Copy to .env and adjust.
# Service-specific .env.example files live in backend/, frontend/ and ml-service/ for local (non-Docker) runs.

# Public URLs (change these when deploying)
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api

# Backend
BACKEND_PORT=5000
JWT_SECRET=<TEMPORARY_SECRET_AT_LEAST_16_CHARS>
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database (compose runs a local mongo; replace with an Atlas URI to use Atlas)
MONGODB_URI=mongodb://mongo:27017/nyaya_ai

# ML service (internal docker network URL)
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_PORT=8000
